{
  "name": "choosepc",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "validate:knowledge": "node scripts/validate_knowledge.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run validate:knowledge && npm run typecheck && npm test && npm run build"
  },
  "dependencies": { "react": "19.2.8", "react-dom": "19.2.8" },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@cloudflare/workers-types": "5.20260729.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  }
}
