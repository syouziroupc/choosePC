{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-assist.invalid/schemas/evaluation-result.schema.json",
  "title": "EvaluationResult",
  "type": "object",
  "required": ["scores", "purchaseAssessment", "decision", "reasons", "reasonDetails", "warnings", "constraints", "engineVersion", "knowledgeVersion"],
  "properties": {
    "scores": {
      "type": "object",
      "required": ["hardware", "fit", "value", "condition", "longevity", "risk", "confidence", "overall"],
      "properties": {
        "hardware": {"type": "number", "minimum": 0, "maximum": 100},
        "fit": {"type": "number", "minimum": 0, "maximum": 100},
        "value": {"type": "number", "minimum": 0, "maximum": 100},
        "condition": {"type": "number", "minimum": 0, "maximum": 100},
        "longevity": {"type": "number", "minimum": 0, "maximum": 100},
        "risk": {"type": "number", "minimum": 0, "maximum": 100},
        "confidence": {"type": "number", "minimum": 0, "maximum": 100},
        "overall": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "purchaseAssessment": {
      "type": "object",
      "required": ["price", "performanceFit", "weaknesses"],
      "properties": {
        "price": {
          "type": "object",
          "required": ["score", "verdict", "marketAvailable"],
          "properties": {
            "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
            "verdict": {"enum": ["good", "fair", "high", "unknown"]},
            "marketAvailable": {"type": "boolean"},
            "fairPriceJpy": {"type": ["number", "null"], "minimum": 0}
          },
          "additionalProperties": false
        },
        "performanceFit": {
          "type": "object",
          "required": ["score", "verdict"],
          "properties": {
            "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
            "verdict": {"enum": ["sufficient", "borderline", "insufficient", "unknown"]}
          },
          "additionalProperties": false
        },
        "weaknesses": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["code", "label", "severity", "message"],
            "properties": {
              "code": {"type": "string"},
              "metric": {"type": "string"},
              "label": {"type": "string"},
              "severity": {"enum": ["critical", "warning", "notice"]},
              "message": {"type": "string"},
              "actual": {"type": ["number", "null"]},
              "minimum": {"type": ["number", "null"]},
              "preferred": {"type": ["number", "null"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "decision": {"enum": ["strong_buy", "buy", "fair", "overpriced", "avoid", "insufficient_data"]},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "reasonDetails": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "object"}},
    "engineVersion": {"type": "string"},
    "knowledgeVersion": {"type": "string"}
  },
  "additionalProperties": false
}
